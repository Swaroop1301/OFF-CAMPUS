# ==============================================================================
# THERMASHELL — Environment Configuration
# ==============================================================================

# Application Environment
DEBUG=True
APP_NAME=THERMASHELL
API_VERSION=v1

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 1. Cloud Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=thermashell_dev

# ------------------------------------------------------------------------------
# 3. Object Storage
# ------------------------------------------------------------------------------
# Set to "supabase" to upload to cloud buckets (climate/, simulation/, ansys/, reports/)
# Set to "local" to store in local directory
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# ------------------------------------------------------------------------------
# 4. Map & Elevation Service Providers
# ------------------------------------------------------------------------------
# Mapbox token (optional if using open Nominatim / Open-Elevation)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6ImNranV...
GEOCODING_PROVIDER=nominatim
ELEVATION_PROVIDER=open-elevation

# ------------------------------------------------------------------------------
# 5. NASA POWER API
# ------------------------------------------------------------------------------
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point
NASA_POWER_CACHE_TTL_HOURS=168

# ------------------------------------------------------------------------------
# 6. Redis & Job Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. ANSYS Fluent Worker Configuration
# ------------------------------------------------------------------------------
# Mode: "local" (PyFluent launches local Fluent), "remote" (connects to running session), "unavailable" (no ANSYS), "detect" (auto-detect)
ANSYS_MODE=detect
ANSYS_PRODUCT_VERSION=24.1
ANSYS_INSTALL_PATH=C:/Program Files/ANSYS Inc/v241/fluent
ANSYS_FLUENT_EXECUTABLE=C:/Program Files/ANSYS Inc/v241/fluent/ntbin/win64/fluent.exe
ANSYS_LICENSE_SERVER=1055@license-server.university.edu
ANSYS_WORKER_HOST=localhost
ANSYS_WORKER_PORT=50051
ANSYS_PROCESSORS=4
ANSYS_PRECISION=double
